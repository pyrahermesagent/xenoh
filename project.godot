; XenoHeart - endless hex-grid exploration for YouTube Playables
config_version=5

[application]

config/name="XenoHeart"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://art/icon.png"

[autoload]

YTGameWrapper="*res://autoloads/yt_game_wrapper.gd"
Game="*res://autoloads/game.gd"

[display]

window/size/viewport_width=768
window/size/viewport_height=432
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/handheld/orientation=0

